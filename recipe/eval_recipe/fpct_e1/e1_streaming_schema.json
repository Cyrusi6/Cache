{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cache.local/schema/fpct/e1/streaming/v6",
  "title": "FPCT-E1 A4 representation-preserving streaming artifacts",
  "description": "Strict schemas for compact geometry, logical-row identities, deterministic physical chunks, and A4 input-lock receipts.",
  "oneOf": [
    {
      "$ref": "#/$defs/inputGeometryManifest"
    },
    {
      "$ref": "#/$defs/inputGeometryReceipt"
    },
    {
      "$ref": "#/$defs/chunkManifest"
    },
    {
      "$ref": "#/$defs/chunkManifestIndex"
    },
    {
      "$ref": "#/$defs/streamingInputLockReceipt"
    },
    {
      "$ref": "#/$defs/streamingInputLockBlockedReceipt"
    },
    {
      "$ref": "#/$defs/syntheticRssLock"
    },
    {
      "$ref": "#/$defs/inputLockManifest"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "protocolHeader": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_id"
      ],
      "properties": {
        "schema_version": {
          "const": 6
        },
        "protocol_id": {
          "const": "fpct_e1_mechanism_audit_v6_representation_preserving_streaming"
        }
      }
    },
    "answerQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_position",
        "target_position",
        "target_token_id"
      ],
      "properties": {
        "query_position": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "target_position": {
          "$ref": "#/$defs/positiveInteger"
        },
        "target_token_id": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "certifiedParent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_position",
        "candidate_count",
        "prior",
        "candidate_indices",
        "candidate_valid_mask",
        "candidate_slot_weights",
        "statistical_weight",
        "topology"
      ],
      "properties": {
        "parent_position": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "prior": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "candidate_indices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "integer", "minimum": -1}
        },
        "candidate_valid_mask": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "boolean"}
        },
        "candidate_slot_weights": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        },
        "statistical_weight": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "topology": {
          "enum": [
            "partition_compositional",
            "competing_overlap",
            "boundary_fallback",
            "neighbor_expansion",
            "taxonomy_unresolved"
          ]
        }
      }
    },
    "provenanceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256",
        "alignment_sha256",
        "labels_sha256",
        "gold_response_sha256"
      ],
      "properties": {
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "alignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "labels_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gold_response_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "logicalRowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_sha256",
        "content_group_sha256",
        "input_sha256",
        "alignment_sha256",
        "labels_sha256",
        "gold_response_sha256",
        "layer",
        "query_head",
        "kv_head",
        "query_position",
        "target_position",
        "target_token_id",
        "parent_position",
        "candidate_count",
        "topology",
        "row_ordinal",
        "logical_row_id",
        "endpoint_id",
        "endpoint_row_id"
      ],
      "properties": {
        "sample_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_group_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "alignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "labels_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gold_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        },
        "query_head": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "kv_head": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "query_position": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "target_position": {
          "$ref": "#/$defs/positiveInteger"
        },
        "target_token_id": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "parent_position": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "topology": {
          "enum": [
            "partition_compositional",
            "competing_overlap",
            "boundary_fallback",
            "neighbor_expansion",
            "taxonomy_unresolved"
          ]
        },
        "row_ordinal": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "logical_row_id": {
          "$ref": "#/$defs/sha256"
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_row_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "geometrySample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "task",
        "sample_sha256",
        "content_group_sha256",
        "item_semantic_sha256",
        "provenance",
        "answer_queries",
        "certified_parents",
        "Q_s",
        "P_s",
        "N_s",
        "answer_query_sequence_sha256",
        "parent_sequence_sha256",
        "raw_topology_compact_sha256",
        "raw_topology_compact",
        "expected_chunk_count"
      ],
      "properties": {
        "schema_version": {
          "const": 6
        },
        "protocol_id": {
          "const": "fpct_e1_mechanism_audit_v6_representation_preserving_streaming"
        },
        "task": {
          "enum": [
            "ai2-arc",
            "openbookqa",
            "mmlu-redux"
          ]
        },
        "sample_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_group_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "item_semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "$ref": "#/$defs/provenanceHashes"
        },
        "answer_queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/answerQuery"
          }
        },
        "certified_parents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/certifiedParent"
          }
        },
        "Q_s": {
          "$ref": "#/$defs/positiveInteger"
        },
        "P_s": {
          "$ref": "#/$defs/positiveInteger"
        },
        "N_s": {
          "$ref": "#/$defs/positiveInteger"
        },
        "answer_query_sequence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_sequence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_topology_compact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_topology_compact": {
          "type": "object",
          "additionalProperties": true
        },
        "expected_chunk_count": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "rowVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sum",
        "min",
        "p50",
        "p95",
        "max",
        "argmax_sample_sha256",
        "argmax_content_group_sha256"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "sum": {
          "$ref": "#/$defs/positiveInteger"
        },
        "min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "p50": {
          "$ref": "#/$defs/positiveInteger"
        },
        "p95": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max": {
          "$ref": "#/$defs/positiveInteger"
        },
        "argmax_sample_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "argmax_content_group_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputGeometryManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "artifact_type",
        "population",
        "task_group_counts",
        "sample_count",
        "samples_parquet",
        "samples_parquet_sha256",
        "samples_parquet_bytes",
        "schema_sha256",
        "sample_sequence_sha256",
        "geometry_semantic_stream_sha256",
        "row_volume",
        "estimated_physical_rows",
        "estimated_disk_bytes",
        "estimated_inode_count",
        "estimated_inode_formula",
        "disk_preflight_passed",
        "inode_preflight_passed",
        "execution_identity_sha256",
        "input_asset_state_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 6
        },
        "protocol_id": {
          "const": "fpct_e1_mechanism_audit_v6_representation_preserving_streaming"
        },
        "artifact_type": {
          "const": "input_geometry_manifest"
        },
        "population": {
          "const": "e0_design"
        },
        "task_group_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ai2-arc",
            "openbookqa",
            "mmlu-redux"
          ],
          "properties": {
            "ai2-arc": {
              "const": 128
            },
            "openbookqa": {
              "const": 70
            },
            "mmlu-redux": {
              "const": 128
            }
          }
        },
        "sample_count": {
          "const": 326
        },
        "samples_parquet": {
          "type": "string",
          "pattern": "^[^/].*\\.parquet$"
        },
        "samples_parquet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "samples_parquet_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_sequence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "geometry_semantic_stream_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "row_volume": {
          "$ref": "#/$defs/rowVolume"
        },
        "estimated_physical_rows": {
          "$ref": "#/$defs/positiveInteger"
        },
        "estimated_disk_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "estimated_inode_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "estimated_inode_formula": {
          "type": "string",
          "minLength": 1
        },
        "disk_preflight_passed": {
          "const": true
        },
        "inode_preflight_passed": {
          "const": true
        },
        "execution_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_asset_state_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputGeometryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "artifact_type",
        "status",
        "manifest_sha256",
        "schema_sha256",
        "sample_count",
        "expanded_logical_rows_materialized",
        "task_counts_exact_128_70_128",
        "input_assets_unchanged_during_lock",
        "input_asset_state_before_sha256",
        "input_asset_state_after_sha256",
        "input_asset_state_sha256",
        "execution_identity_sha256",
        "bounded_geometry_replay_equal",
        "pass_b_geometry_source_only",
        "e1_pilot_consumed",
        "model_or_checkpoint_loaded",
