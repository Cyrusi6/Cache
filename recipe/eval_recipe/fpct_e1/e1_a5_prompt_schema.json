{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cache.local/schema/fpct/e1/a5-prompt/v7",
  "title": "FPCT-E1 A5 actual E0 production-runtime prompt artifacts",
  "description": "Strict schemas for the A5 dual-anchor census, its full-population manifest, the versioned pre-natural gate, and fail-closed input-lock receipts.",
  "oneOf": [
    {
      "$ref": "#/$defs/a5PromptCensusRecord"
    },
    {
      "$ref": "#/$defs/a5PromptCensusManifest"
    },
    {
      "$ref": "#/$defs/a5PromptSyntheticGate"
    },
    {
      "$ref": "#/$defs/a5InputLockGoReceipt"
    },
    {
      "$ref": "#/$defs/a5InputLockBlockedReceipt"
    },
    {
      "$ref": "#/$defs/a5InputLockManifest"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "task": {
      "enum": [
        "ai2-arc",
        "openbookqa",
        "mmlu-redux"
      ]
    },
    "promptRelation": {
      "enum": [
        "EXACT_HISTORICAL_AND_PRODUCTION_MATCH",
        "EXTRA_CHOICES_ONLY"
      ]
    },
    "protocolHeader": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_id"
      ],
      "properties": {
        "schema_version": {
          "const": 7
        },
        "protocol_id": {
          "const": "fpct_e1_mechanism_audit_v7_actual_e0_runtime_prompt"
        }
      }
    },
    "sourceRowId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      ]
    },
    "choiceLabels": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]$"
      }
    },
    "a5PromptCensusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "artifact_type",
        "task",
        "content_group_sha256",
        "sample_key_sha256",
        "source_row_id",
        "historical_choice_count",
        "production_choice_count",
        "raw_choice_labels",
        "gold_answer",
        "historical_first4_question_choices_sha256",
        "historical_rendered_prompt_sha256",
        "historical_alignment_sha256",
        "raw_full_row_sha256",
        "production_rendered_prompt_sha256",
        "production_alignment_sha256",
        "historical_prompt_token_count",
        "production_prompt_token_count",
        "production_certified_parent_count",
        "production_logical_row_count",
        "production_physical_chunk_count",
        "prompt_relation",
        "choice_difference_only"
      ],
      "properties": {
        "schema_version": {
          "const": 7
        },
        "protocol_id": {
          "const": "fpct_e1_mechanism_audit_v7_actual_e0_runtime_prompt"
        },
        "artifact_type": {
          "const": "a5_prompt_census_record"
        },
        "task": {
          "$ref": "#/$defs/task"
        },
        "content_group_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_key_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_row_id": {
          "$ref": "#/$defs/sourceRowId"
        },
        "historical_choice_count": {
          "const": 4
        },
        "production_choice_count": {
          "type": "integer",
          "minimum": 4
        },
        "raw_choice_labels": {
          "$ref": "#/$defs/choiceLabels"
        },
        "gold_answer": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "historical_first4_question_choices_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "historical_rendered_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "historical_alignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_full_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "production_rendered_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "production_alignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "historical_prompt_token_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "production_prompt_token_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "production_certified_parent_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "production_logical_row_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "production_physical_chunk_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "prompt_relation": {
          "$ref": "#/$defs/promptRelation"
        },
        "choice_difference_only": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "prompt_relation": {
                "const": "EXACT_HISTORICAL_AND_PRODUCTION_MATCH"
              }
            },
            "required": [
              "prompt_relation"
            ]
          },
          "then": {
            "properties": {
              "production_choice_count": {
                "const": 4
              },
              "choice_difference_only": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "prompt_relation": {
                "const": "EXTRA_CHOICES_ONLY"
              }
            },
            "required": [
              "prompt_relation"
            ]
          },
          "then": {
            "properties": {
              "production_choice_count": {
                "type": "integer",
                "minimum": 5
              },
              "choice_difference_only": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "taskCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai2-arc",
        "openbookqa",
        "mmlu-redux"
      ],
      "properties": {
        "ai2-arc": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "openbookqa": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "mmlu-redux": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "exactPopulationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai2-arc",
        "openbookqa",
        "mmlu-redux"
      ],
      "properties": {
        "ai2-arc": {
          "const": 128
        },
        "openbookqa": {
          "const": 70
        },
        "mmlu-redux": {
          "const": 128
        }
      }
    },
    "integerHistogram": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonNegativeInteger"
      }
    },
    "distributionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sum",
        "min",
        "p50",
        "p95",
        "max",
        "argmax_content_group_sha256"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "sum": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "min": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "p50": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "p95": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "max": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "argmax_content_group_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "anchorMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "content_group_sha256",
        "sample_key_sha256",
        "historical_first4_question_choices_sha256",
        "historical_rendered_prompt_sha256",
        "historical_alignment_sha256",
        "raw_full_row_sha256",
        "production_rendered_prompt_sha256",
        "production_alignment_sha256",
        "prompt_relation"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/task"
        },
        "content_group_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_key_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "historical_first4_question_choices_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "historical_rendered_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "historical_alignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_full_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "production_rendered_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "production_alignment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_relation": {
          "$ref": "#/$defs/promptRelation"
        }
      }
    },
    "artifactDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "bytes",
        "row_count"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "row_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "a5PromptCensusManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "artifact_type",
        "status",
