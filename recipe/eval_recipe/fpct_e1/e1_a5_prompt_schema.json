        "production_physical_chunk_count_distribution",
        "unexpected_prompt_difference_count",
        "missing_row_count",
        "duplicate_row_count",
        "canonical_semantic_stream_sha256",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": 7
        },
        "protocol_id": {
          "const": "fpct_e1_mechanism_audit_v7_actual_e0_runtime_prompt"
        },
        "artifact_type": {
          "const": "a5_prompt_census_manifest"
        },
        "status": {
          "const": "COMPLETE_PRE_MODEL_CENSUS"
        },
        "execution_sha": {
          "$ref": "#/$defs/gitSha40"
        },
        "run_uid": {
          "type": "string",
          "pattern": "^fpct-e1-a5-runtime-prompt-[0-9a-f]{8,40}-v1$"
        },
        "population_count": {
          "const": 326
        },
        "task_counts": {
          "$ref": "#/$defs/exactPopulationCounts"
        },
        "affected_task_counts": {
          "$ref": "#/$defs/taskCounts"
        },
        "unaffected_task_counts": {
          "$ref": "#/$defs/taskCounts"
        },
        "historical_choice_count_distribution": {
          "$ref": "#/$defs/integerHistogram"
        },
        "production_choice_count_distribution": {
          "$ref": "#/$defs/integerHistogram"
        },
        "affected_content_group_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "historical_to_production_anchor_map": {
          "type": "array",
          "minItems": 326,
          "maxItems": 326,
          "items": {
            "$ref": "#/$defs/anchorMapping"
          }
        },
        "production_prompt_token_count_distribution": {
          "$ref": "#/$defs/distributionSummary"
        },
        "production_certified_parent_count_distribution": {
          "$ref": "#/$defs/distributionSummary"
        },
        "production_logical_row_count_distribution": {
          "$ref": "#/$defs/distributionSummary"
        },
        "production_physical_chunk_count_distribution": {
          "$ref": "#/$defs/distributionSummary"
        },
        "unexpected_prompt_difference_count": {
          "const": 0
        },
        "missing_row_count": {
          "const": 0
        },
        "duplicate_row_count": {
          "const": 0
        },
        "canonical_semantic_stream_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactDescriptor"
          }
        }
      }
    },
